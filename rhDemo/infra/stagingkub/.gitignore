# Certificats SSL générés
certs/
*.crt
*.key
*.pem

# Fichiers temporaires
*.tmp
*.bak

# Secrets locaux (ne jamais commiter)
secrets/
*.secret

# Ancienne copie locale des valeurs Grafana avec mot de passe (avant OpenBao) : à détruire
helm/observability/*.local-avant-openbao

# Logs
*.log

# Anciens kubeconfigs de Jenkins écrits par init-stagingkub.sh (tokens en clair) : plus générés
# depuis la rotation par rotate-secrets.py, à détruire après la première rotation
jenkins-kubeconfig/
