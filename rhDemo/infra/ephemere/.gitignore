# Ignore environment configuration
.env

# Certificats et clés générés par generate-certs.sh (jamais versionnés)
certs/*
# Ancien emplacement (nginx/generate-certs.sh supprimé)
nginx/ssl/

# Ignore backups
*.backup
*.bak
*.sql.gz
*.dump

# Ignore logs
*.log
logs/

# Ignore temporary files
*.tmp
*.swp
*~
