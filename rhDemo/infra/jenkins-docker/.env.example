# ═══════════════════════════════════════════════════════════════════
# FICHIER .ENV POUR JENKINS
# Configuration des variables d'environnement
# ═══════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# JENKINS ADMIN
# ⚠️  OBLIGATOIRE — Ces variables sont requises au démarrage.
#     docker compose up échouera si elles sont absentes ou vides.
# ────────────────────────────────────────────────────────────────
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=CHANGER_MOT_DE_PASSE_ADMIN
JENKINS_CLAUDE_PASSWORD=CHANGER_MOT_DE_PASSE_CLAUDE

# ────────────────────────────────────────────────────────────────
# SONARQUBE
# ────────────────────────────────────────────────────────────────
SONAR_URL=http://sonarqube:9000
# A configurer en interactif dans Jenkins admin/credentials 
# Après avoir généré le token coté admin Sonar
# SONAR_TOKEN=your-sonar-token
SONAR_DB_PASSWORD=CHANGER_MOT_DE_PASSE_SONAR

# ────────────────────────────────────────────────────────────────
# EMAIL NOTIFICATIONS
# ────────────────────────────────────────────────────────────────
# La config SMTP (host, port, credential smtp-infomaniak-credentials) se fait
# entièrement à la main dans Jenkins UI (Manage Jenkins > System > Extended
# E-mail Notification) — aucune variable d'environnement ne la pilote, cf.
# jenkins-casc.yaml section CREDENTIALS (#9) pour le pourquoi (limitation JCasC).

# ⚠️  OBLIGATOIRE — Adresse mail des notifications de fin de pipeline
#     (RHDemo-CI/CD/Renovate/Stagingkub-Upgrade-Deploy). Interpolée dans
#     unclassified.location.adminAddress (jenkins-casc.yaml) : doit être la MÊME
#     adresse que le Username du credential smtp-infomaniak-credentials (compte
#     SMTP authentifié — Infomaniak rejette l'envoi en cas de mismatch, cf.
#     jenkins-casc.yaml) et que le credential Jenkins "notification-email"
#     (Secret text, à créer manuellement dans Jenkins UI — les pipelines lisent
#     le destinataire depuis ce credential, pas depuis cette variable).
JENKINS_NOTIFICATION_EMAIL=me@myserver.com

# ────────────────────────────────────────────────────────────────
# SOPS
# ────────────────────────────────────────────────────────────────
# S'agissant d'un pointeur vers un fichier de clés le secret SOPS 
# à associer à la clé sops-age-key ne peut être configuré que via Jenkins admin/credentials.

# ────────────────────────────────────────────────────────────────
# OWASP DEPENDENCY-CHECK
# ────────────────────────────────────────────────────────────────
# NVD API Key : À configurer manuellement dans Jenkins admin/credentials
# Credential ID : nvd-api-key (Secret text)
# Obtenir une clé sur: https://nvd.nist.gov/developers/request-an-api-key

# ────────────────────────────────────────────────────────────────
# CHEMINS HÔTE
# ────────────────────────────────────────────────────────────────
# Chemin absolu vers la racine du dépôt git (utilisé pour monter le
# certificat registry dans les agents éphémères via Docker Cloud)
REPOSITORY_PATH=/home/votre-user/git/repository

# ────────────────────────────────────────────────────────────────
# TIMEZONE
# ────────────────────────────────────────────────────────────────
TZ=Europe/Paris
