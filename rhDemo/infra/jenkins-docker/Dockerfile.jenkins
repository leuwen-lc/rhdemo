FROM jenkins/jenkins:2.580.2-lts-jdk25@sha256:415ab90d4e3b25148f7191bc04f455a20817d6c4c3b0a98f6c6b0da4877f7081

# ═══════════════════════════════════════════════════════════════════
# JENKINS CONTROLLER (master) - PILOTAGE UNIQUEMENT
# ═══════════════════════════════════════════════════════════════════
# Ce Dockerfile ne contient que le nécessaire pour le contrôleur Jenkins.
# Tous les outils de build (Maven, JDK 25, Docker, Trivy, kubectl,
# Helm, Cosign, Firefox/Selenium, etc.) sont installés dans l'agent
# dédié (Dockerfile.agent).
#
# Le master ne fait que du pilotage : orchestration des pipelines,
# gestion des credentials, interface web, JCasC.
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# CONFIGURATION DES PLUGINS JENKINS
# ═══════════════════════════════════════════════════════════════════

# Désactiver le wizard de setup initial
# -XX:-UseBASE64Intrinsics : contournement CVE-2026-114938 (Java4Shell), à retirer avec un JDK corrigé
# -D...DockerContainerWatchdog.recurrenceInSeconds=30 : nettoyage des conteneurs d'agents orphelins
#   toutes les 30 s au lieu de 300. Un arrêt d'agent échoue parfois (« Broken pipe » : connexion
#   keep-alive fermée par docker-socket-proxy après 10 s d'inactivité) ; le conteneur occupe alors
#   l'unique place (instanceCap 1) et le build suivant attend « waiting for available executor ».
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false -XX:-UseBASE64Intrinsics -Dcom.nirima.jenkins.plugins.docker.DockerContainerWatchdog.recurrenceInSeconds=30"

# Liste des plugins à installer automatiquement
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt

RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# ═══════════════════════════════════════════════════════════════════
# CONFIGURATION JENKINS AS CODE (JCasC)
# ═══════════════════════════════════════════════════════════════════

# Copier la configuration JCasC
# (docker-compose.yml monte en plus ./casc par-dessus ce dossier, en lecture seule)
COPY casc/jenkins-casc.yaml /var/jenkins_home/casc_configs/jenkins-casc.yaml

ENV CASC_JENKINS_CONFIG=/var/jenkins_home/casc_configs

# ═══════════════════════════════════════════════════════════════════
# SÉCURITÉ : ca-certificates à jour (CVE-2026-111943, CA eMudhra compromises)
# ═══════════════════════════════════════════════════════════════════
# Version Debian 13 corrigée : 20250419+deb13u1. Voir docs/SECURITE_CA_EMUDHRA_PLAN.md
USER root
RUN apt-get update && apt-get install -y --only-upgrade ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# ═══════════════════════════════════════════════════════════════════
# AUTORITÉ LOCALE RHDEMO (OpenBao en TLS, docs/OPENBAO.md)
# ═══════════════════════════════════════════════════════════════════
# Le plugin HashiCorp Vault, exécuté par le contrôleur, joint https://openbao:8200 :
# la racine locale (openbao/init-local-ca.sh ca) est ajoutée au truststore Java.
# Les jokers (cert[s]/c[a]/root-ca.crt*) rendent la copie facultative (aucune correspondance tant que
# l'autorité n'existe pas) ; openbao/config.hcl garantit au moins un fichier source.
# Après création de l'autorité : ./start-jenkins.sh --rebuild.
COPY openbao/config.hcl cert[s]/c[a]/root-ca.crt* /tmp/rhdemo-ca/
RUN if [ -f /tmp/rhdemo-ca/root-ca.crt ]; then \
        keytool -importcert -noprompt -cacerts -storepass changeit \
            -alias rhdemo-root-ca -file /tmp/rhdemo-ca/root-ca.crt; \
    fi && rm -rf /tmp/rhdemo-ca
USER jenkins

# ═══════════════════════════════════════════════════════════════════
# CONFIGURATION FINALE
# ═══════════════════════════════════════════════════════════════════

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8080/login || exit 1

EXPOSE 8080 50000
